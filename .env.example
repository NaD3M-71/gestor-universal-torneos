# Copiar este archivo como .env y completar los valores reales.
# El archivo .env no se sube a GitHub.

# Entorno del backend: development, production o test
NODE_ENV=development

# Puerto del backend
PORT=3000

# Cadena de conexión a PostgreSQL.
# Base local:    postgresql://usuario:contraseña@localhost:5432/nombre_base
# Base Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/postgres

# Secreto para firmar los JWT. Usar una cadena larga y aleatoria.
JWT_SECRET=cambiar_por_un_secreto_largo

# URL de la API que usa el frontend (debe terminar en /api y coincidir con PORT)
VITE_API_URL=http://localhost:3000/api
